{
  "name": "nexo-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "expo start --android",
    "api:types": "openapi-typescript docs/openapi.json -o src/core/api/contracts/openapi.d.ts",
    "ios": "expo start --ios",
    "start": "expo start",
    "test:contrato": "esbuild scripts/contrato.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/contrato.cjs --alias:@core=./src/core --alias:@shared=./src/shared --alias:@features=./src/features --log-level=error && node node_modules/.cache/contrato.cjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.2.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.2.3",
    "@expo-google-fonts/ibm-plex-sans": "^0.2.3",
    "@expo/metro-runtime": "~3.2.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.51.1",
    "axios": "^1.7.7",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.9",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-paper": "^5.12.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "^0.19.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.2",
    "esbuild": "^0.23.1",
    "openapi-typescript": "^7.4.0",
    "typescript": "~5.6.3"
  }
}
